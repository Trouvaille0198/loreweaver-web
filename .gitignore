# Dependencies / build output
node_modules/
dist/
dist-new/
target/
__pycache__/
.vite-cache/

# Tauri generated schemas (regenerated on every build)
src-tauri/gen/schemas/

# Local files
.DS_Store
*.local

# 运行时数据（bind mount 的目标：钥匙/战役库/媒体/备份——绝不进 git）
data/

# compose 环境覆盖（本机 uid 映射——data/ 属主是 1000，VPS 是 1001）
.env

# Skill 本机配置（模板 config_example.json 可提交）
.agents/skills/*/config.json
